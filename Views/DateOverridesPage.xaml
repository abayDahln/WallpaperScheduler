<Page
    x:Class="WallpaperScheduler.Views.DateOverridesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,28,32,0" Spacing="6">
            <TextBlock Text="Date Overrides" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Pick a date, then manage its wallpaper slots. Priority: Specific Date &gt; Monthly &gt; Weekly."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,20,32,28" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: calendar -->
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Calendar" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <CalendarView x:Name="DateCalendar"
                              SelectedDatesChanged="OnDateSelected"
                              CalendarViewDayItemChanging="OnDayItemChanging"
                              SelectionMode="Single"/>
            </StackPanel>

            <!-- Right: slots for the selected date -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                    <TextBlock x:Name="SelectedDateTitle" Text="Select a date" Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="AddSlotBtn" Click="OnAddSlotClick" Style="{StaticResource AccentButtonStyle}"
                            Width="32" Height="32" Padding="4"
                            AutomationProperties.Name="Add Wallpaper"
                            ToolTipService.ToolTip="Add Wallpaper" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE91B;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No wallpaper for this date"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click &quot;+ Add Wallpaper&quot; and pick a wallpaper to schedule this date."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" MaxWidth="340" TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="SlotListPanel" Margin="0,4,0,0" Spacing="8"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
