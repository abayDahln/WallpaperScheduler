<Page
    x:Class="WallpaperScheduler.Views.MonthlyOverridesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WallpaperScheduler.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,28,32,0" Spacing="6">
            <TextBlock Text="Monthly Overrides" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Pick a day of the month, then manage its wallpaper slots. Priority: Specific Date &gt; Monthly &gt; Weekly."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,20,32,28" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: month day calendar -->
            <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Month" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <GridView x:Name="DayGrid"
                              ItemsSource="{x:Bind DayCells, Mode=OneWay}"
                              SelectionChanged="OnDaySelected"
                              SelectionMode="Single"
                              Width="420">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:DayCell">
                                <Border Width="52" Height="52" CornerRadius="8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Day}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                 Margin="0,0,0,6"
                                                 Visibility="{x:Bind local:MonthlyOverridesPage.HasOverrideToVisibility(HasOverride)}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

            <!-- Right: slots for the selected day -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,32,0">
                    <TextBlock x:Name="SelectedDayTitle" Text="Select a day" Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="AddSlotBtn" Click="OnAddSlotClick" Style="{StaticResource AccentButtonStyle}"
                            Width="32" Height="32" Padding="4"
                            AutomationProperties.Name="Add Wallpaper"
                            ToolTipService.ToolTip="Add Wallpaper" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE91B;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No wallpaper for this day"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Click &quot;+ Add Wallpaper&quot; and pick a wallpaper to schedule this day of the month."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" MaxWidth="340" TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="SlotListPanel" Margin="0,4,0,0" Spacing="8"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
