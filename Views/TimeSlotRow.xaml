<UserControl
    x:Class="WallpaperScheduler.Views.TimeSlotRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Padding="12" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Start time" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="StartBtn" Width="68" Height="32" Padding="0" FontSize="14"
                        Content="{x:Bind StartLabel}" Click="OnStartClick" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="End time" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="EndBtn" Width="68" Height="32" Padding="0" FontSize="14"
                        Content="{x:Bind EndLabel}" Click="OnEndClick" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Wallpaper" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="WallpaperBtn" Height="40" Padding="8,2" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="OnWallpaperClick"
                        AutomationProperties.Name="{x:Bind WallpaperLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="48" Height="27" CornerRadius="4"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Source="{x:Bind WallpaperThumbnail}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{x:Bind WallpaperLabel}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="Style" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="StyleCombo" ItemsSource="{x:Bind StyleOptions}" Width="110" Height="32"
                          SelectionChanged="OnStyleChanged"/>
            </StackPanel>

            <Button x:Name="RemoveBtn" Grid.Column="5" Content="Remove" VerticalAlignment="Center"
                    Click="OnRemoveClick"/>
        </Grid>
    </Border>
</UserControl>
