<Page
    x:Class="WallpaperScheduler.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Spacing="12">
            <ToggleSwitch Header="Auto-start on boot" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" Toggled="OnAutoStartToggled"/>
            <ToggleSwitch Header="Minimize to tray on close" IsOn="{x:Bind ViewModel.CloseMinimizesToTray, Mode=TwoWay}" Toggled="OnCloseMinimizesToggled"/>
            <ToggleSwitch Header="Notify on wallpaper change" IsOn="{x:Bind ViewModel.NotifyOnChange, Mode=TwoWay}" Toggled="OnNotifyToggled"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Wallpaper Style" FontWeight="Bold"/>
            <ComboBox ItemsSource="{x:Bind StyleOptions}" SelectedItem="{x:Bind ViewModel.WallpaperStyle, Mode=TwoWay}" Width="200" SelectionChanged="OnStyleChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Theme" FontWeight="Bold"/>
            <ComboBox ItemsSource="{x:Bind ThemeOptions}" SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" Width="200" SelectionChanged="OnThemeChanged"/>
        </StackPanel>
    </Grid>
</Page>