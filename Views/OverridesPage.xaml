<Page
    x:Class="WallpaperScheduler.Views.OverridesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WallpaperScheduler.Models"
    xmlns:local="using:WallpaperScheduler.Views"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Overrides" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Priority: Specific Date  >  Monthly  >  Weekly"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Monthly recurring -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="Monthly Recurring" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <ComboBox x:Name="MonthlyDayInput" Header="Day of month (1-31)"
                                  ItemsSource="{x:Bind DayNumbers, Mode=OneWay}"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Left" MinWidth="180"/>
                        <ComboBox x:Name="MonthlyWallpaperCombo" Header="Wallpaper"
                                  ItemsSource="{x:Bind Wallpapers}"
                                  SelectedValuePath="Id"
                                  PlaceholderText="Select wallpaper…"
                                  HorizontalAlignment="Left" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WallpaperItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                                        <Border Width="24" Height="24" CornerRadius="4"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Add Monthly Override" Click="OnAddMonthlyClick"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <ListView ItemsSource="{x:Bind MonthlyOverrides, Mode=OneWay}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MonthlyRecord">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="10,2" CornerRadius="10"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind DayLabel}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind WallpaperLabel}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="Remove" Click="OnRemoveMonthlyClick" Tag="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Specific date -->
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Specific Date" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <CalendarDatePicker x:Name="DatePicker" Header="Date" PlaceholderText="Pick a date"
                                            HorizontalAlignment="Left" MinWidth="220"
                                            DayOfWeekFormat="none"/>
                        <ComboBox x:Name="DateWallpaperCombo" Header="Wallpaper"
                                  ItemsSource="{x:Bind Wallpapers}"
                                  SelectedValuePath="Id"
                                  PlaceholderText="Select wallpaper…"
                                  HorizontalAlignment="Left" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WallpaperItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                                        <Border Width="24" Height="24" CornerRadius="4"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Add Date Override" Click="OnAddDateClick"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <ListView ItemsSource="{x:Bind DateOverrides, Mode=OneWay}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DateRecord">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="10,2" CornerRadius="10"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind DateLabel}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind WallpaperLabel}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="Remove" Click="OnRemoveDateClick" Tag="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>