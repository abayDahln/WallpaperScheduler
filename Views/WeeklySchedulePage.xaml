<Page
    x:Class="WallpaperScheduler.Views.WeeklySchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WallpaperScheduler.Views"
    xmlns:models="using:WallpaperScheduler.Models"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Weekly Schedule" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Text="Pick a day, then edit its time slots. Changes save automatically."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Day list -->
            <ListView x:Name="DayList"
                      Grid.Column="0"
                      ItemsSource="{x:Bind Days, Mode=OneWay}"
                      SelectionChanged="OnDaySelectionChanged"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DayEntry">
                        <Grid Padding="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind Summary, Mode=OneWay}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind SlotCount, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Slot editor -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="SelectedDayTitle" Text="Monday" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button Content="+ Add Slot" Click="OnAddSlotClick"/>
                    <Button Content="Clear Day" Click="OnClearDayClick"/>
                    <Button Content="Import Wallpaper" Click="OnImportClick"/>
                    <TextBlock Text="Slots must not overlap. Gaps fall back to the previous slot's wallpaper."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                    <TextBlock Text="Copy this day to:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CopyTargetDay"
                              ItemsSource="{x:Bind Days, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              Width="180"/>
                    <Button Content="Copy" Click="OnCopyToClick"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{x:Bind Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DaySlotEditor">
                                <Border Padding="12" Margin="0,4" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Start" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TimePicker Grid.Column="1" Time="{x:Bind StartTime, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock"
                                                    TimeChanged="OnSlotEdited"
                                                    HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="End" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TimePicker Grid.Column="3" Time="{x:Bind EndTime, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock"
                                                    TimeChanged="OnSlotEdited"
                                                    HorizontalAlignment="Left"/>

                                        <!-- Wallpaper picker with thumbnail -->
                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{x:Bind Wallpapers}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{x:Bind WallpaperId, Mode=OneWay}"
                                                  SelectionChanged="OnWallpaperSelected"
                                                  PlaceholderText="Select wallpaper…"
                                                  VerticalAlignment="Center"
                                                  MinWidth="220">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:WallpaperItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                                                        <Border Width="28" Height="28" CornerRadius="4"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Grid.Column="5" Content="Remove" Click="OnRemoveSlotClick" Tag="{Binding}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>