<Page
    x:Class="WallpaperScheduler.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <Grid Padding="32,28,32,28" MaxWidth="1304" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock Text="Overview" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Review your schedule and set the default wallpaper used when no slot applies."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,24,0,0" RowSpacing="20" ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Schedule summary: full width, one row tall, compact -->
                    <StackPanel x:Name="SummarySection" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="StatWallpapers" FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Wallpapers"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="StatWeekly" FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Weekly slots"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="StatMonthly" FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Monthly overrides"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock x:Name="StatDates" FontWeight="SemiBold"
                                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Date overrides"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    </StackPanel>

                    <!-- Current wallpaper -->
                    <StackPanel x:Name="CurrentSection" Grid.Row="1" Grid.Column="0" Spacing="12">
                        <TextBlock Text="Current Wallpaper" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Border x:Name="CurrentImageFrame" Height="150" CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image x:Name="CurrentImage" Stretch="UniformToFill" Margin="2"/>
                        </Border>
                        <TextBlock x:Name="CurrentLabel" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="NextChangeText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Default wallpaper -->
                    <StackPanel x:Name="DefaultSection" Grid.Row="1" Grid.Column="1" Spacing="12">
                        <TextBlock Text="Default Wallpaper" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Border x:Name="DefaultThumbFrame" Height="150" CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image x:Name="DefaultThumb" Stretch="UniformToFill" Margin="2"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Import Wallpaper" Click="OnImportClick"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Clear" Click="OnClearDefaultClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current:" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DefaultLabelText" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SummarySection.(Grid.Row)" Value="0"/>
                                <Setter Target="SummarySection.(Grid.Column)" Value="0"/>
                                <Setter Target="SummarySection.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="CurrentSection.(Grid.Row)" Value="1"/>
                                <Setter Target="CurrentSection.(Grid.Column)" Value="0"/>
                                <Setter Target="CurrentSection.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="DefaultSection.(Grid.Row)" Value="2"/>
                                <Setter Target="DefaultSection.(Grid.Column)" Value="0"/>
                                <Setter Target="DefaultSection.(Grid.ColumnSpan)" Value="2"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1200"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SummarySection.(Grid.Row)" Value="0"/>
                                <Setter Target="SummarySection.(Grid.Column)" Value="0"/>
                                <Setter Target="SummarySection.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="CurrentSection.(Grid.Row)" Value="1"/>
                                <Setter Target="CurrentSection.(Grid.Column)" Value="0"/>
                                <Setter Target="CurrentSection.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="DefaultSection.(Grid.Row)" Value="1"/>
                                <Setter Target="DefaultSection.(Grid.Column)" Value="1"/>
                                <Setter Target="DefaultSection.(Grid.ColumnSpan)" Value="1"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
